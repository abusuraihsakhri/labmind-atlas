# =============================================================================
# LabMind Environment Configuration
# Copy this file to .env and fill in secure values before deployment.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
POSTGRES_DB=labmind
POSTGRES_USER=labmind_admin
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# --- Redis ---
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# --- Gateway (On-Premise) ---
DATABASE_URL=postgresql://labmind_admin:<CHANGE_ME_STRONG_PASSWORD>@db:5432/labmind
RE_ID_MAP_KEY=<GENERATE_WITH_FERNET_KEY_generate_key()>
GATEWAY_RESOLVE_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
GATEWAY_INGEST_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>

# --- AI / LLM Intelligence Engine (Bring Your Own Model) ---
# Supported providers: ollama (100% on-prem private), anthropic, openai, custom
LLM_PROVIDER=ollama

# Option A: Local Ollama (100% On-Premise Air-Gapped / Privacy First)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_WORKER_MODEL=llama3.2
OLLAMA_SUPERVISOR_MODEL=llama3.2

# Option B: Anthropic Claude (Cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKER_MODEL=claude-3-haiku-20240307
ANTHROPIC_SUPERVISOR_MODEL=claude-3-5-sonnet-20241022

# Option C: OpenAI / OpenAI-Compatible Endpoints (vLLM, LM Studio, LocalAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WORKER_MODEL=gpt-4o-mini
OPENAI_SUPERVISOR_MODEL=gpt-4o

# Option D: Generic Custom LLM Endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# --- Security & Cryptographic Secrets ---
AUDIT_SECRET_KEY=<CHANGE_ME_RANDOM_64_CHAR_STRING>

# --- RBAC Auth Tokens (generate with: openssl rand -hex 32) ---
TIER2_AUTH_SECRET=<CHANGE_ME_RANDOM_TOKEN>
TIER3_AUTH_SECRET=<CHANGE_ME_RANDOM_TOKEN>
SERVICE_AUTH_SECRET=<CHANGE_ME_RANDOM_TOKEN>

# --- Token Generation ---
TOKEN_SALT=<CHANGE_ME_RANDOM_64_CHAR_STRING>

# --- Notifications (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your_email@gmail.com>
SMTP_PASSWORD=<your_app_password>
SMTP_FROM=<your_email@gmail.com>
ALERT_EMAIL=<clinician_email@example.com>
ALERT_PHONE=<+1234567890>
SMS_API_URL=
SMS_API_KEY=
